{$SITE_ADDRESS} {
	# Öffentlicher Hostname: Caddy holt das Zertifikat automatisch.
	# Nur intern erreichbarer Hostname: die nächste Zeile aktivieren und die
	# Caddy-Root-CA auf den Clients verteilen, oder ein Firmenzertifikat nutzen.
	# tls internal

	# Empfohlen: nur Firmennetz und VPN zulassen, Netze anpassen und aktivieren.
	# @fremd not remote_ip 10.0.0.0/8 192.168.0.0/16
	# respond @fremd "Kein Zugriff" 403

